    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/tovyr-postinstall.js",
    "prepublishOnly": "node -e \"const fs=require('fs');['bin/graft.js','bin/tovyr.js','src/constants/tovyr.js','docs/GUIDE.md'].forEach(p=>fs.accessSync(p));\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "ws": "^8.21.0"
