    "bin/tovyr.js",
    "bin/tovyr.cmd",
    "bin/tovyr.ps1",
    "src/constants/tovyr.js",
    "constants/*.js",
    "runtime/",
    "scripts/tovyr-*.js",
    "scripts/tovyr-doctor.js",
    "scripts/tovyr-home.js",
    "scripts/tovyr-install-checks.js",
    "scripts/tovyr-launch-hints.js",
    "scripts/tovyr-model-compat.js",
    "scripts/tovyr-warm.js",
    "scripts/tovyr-package-root.js",
    "scripts/tovyr-postinstall.js",
    "scripts/tovyr-prep-auth.js",
    "scripts/tovyr-provider-catalog-extra.js",
    "scripts/tovyr-provider-models-expanded.js",
    "scripts/tovyr-provider-catalog.js",
    "scripts/tovyr-provider-cli.js",
    "scripts/tovyr-providers.js",
    "scripts/tovyr-save-api-key.js",
    "scripts/tovyr-sync-freemodel-settings.js",
    "scripts/tovyr-tune-settings.js",
