{
  "name": "tovyr",
  "version": "1.3.6",
  "description": "Tovyr — a fast, polished AI coding agent for your terminal",
  "type": "module",
  "license": "MIT",
  "author": "itsdexy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzdexy/Tovyr.git"
  },
  "bugs": {
    "url": "https://github.com/itzdexy/Tovyr/issues"
  },
  "homepage": "https://github.com/itzdexy/Tovyr#readme",
  "keywords": [
    "tovyr",
    "tovyrcode",
    "ai",
    "coding-agent",
    "cli",
    "freemodel",
    "assistant"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tovyr": "./bin/tovyr.js"
  },
  "files": [
    "bin/tovyr.js",
    "bin/tovyr.cmd",
    "bin/tovyr.ps1",
    "constants/*.js",
    "runtime/",
    "scripts/tovyr-*.js",
    "scripts/tovyr-doctor.js",
    "scripts/tovyr-home.js",
    "scripts/tovyr-install-checks.js",
    "scripts/tovyr-launch-hints.js",
    "scripts/tovyr-model-compat.js",
    "scripts/tovyr-warm.js",
    "scripts/tovyr-package-root.js",
    "scripts/tovyr-postinstall.js",
    "scripts/tovyr-prep-auth.js",
    "scripts/tovyr-provider-catalog-extra.js",
    "scripts/tovyr-provider-models-expanded.js",
    "scripts/tovyr-provider-catalog.js",
    "scripts/tovyr-provider-cli.js",
    "scripts/tovyr-providers.js",
    "scripts/tovyr-save-api-key.js",
    "scripts/tovyr-sync-freemodel-settings.js",
    "scripts/tovyr-tune-settings.js",
    "scripts/tovyr-windows-launcher.js",
    "docs/GUIDE.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/tovyr-postinstall.js",
    "prepublishOnly": "node -e \"const fs=require('fs');['bin/tovyr.js','docs/GUIDE.md'].forEach(p=>fs.accessSync(p));\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "ws": "^8.21.0"
  }
}
