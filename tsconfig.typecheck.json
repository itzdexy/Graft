{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": [
    "src/utils/filePersistence/**/*.ts",
    "src/utils/tovyrStartupLoader.ts",
    "src/hooks/useTovyrBootScreen.ts",
    "src/components/tovyr/**/*.tsx",
    "src/mcp/builtin/**/*.ts",
    "src/commands/tovyr/superthink.impl.tsx",
    "src/services/tovyr/intent/**/*.ts",
    "src/services/tovyr/openaiCompat/**/*.ts",
    "src/services/tovyr/modelContext.ts",
    "src/services/tovyr/validateProviderModel.ts",
    "src/services/tovyr/providerFailover.ts",
    "src/services/tovyr/applyActiveProvider.ts",
    "src/services/tovyr/providerModels.ts",
    "src/constants/tovyrSystemPrompt.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
