{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": [
    "utils/filePersistence/**/*.ts",
    "utils/blinkStartupLoader.ts",
    "hooks/useBlinkBootScreen.ts",
    "components/blink/**/*.tsx",
    "mcp/builtin/**/*.ts",
    "commands/blink/superthink.impl.tsx",
    "services/blink/intent/**/*.ts",
    "services/blink/openaiCompat/**/*.ts",
    "services/blink/modelContext.ts",
    "services/blink/validateProviderModel.ts",
    "services/blink/providerFailover.ts",
    "services/blink/applyActiveProvider.ts",
    "services/blink/providerModels.ts",
    "constants/blinkSystemPrompt.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
